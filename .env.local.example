# ==============================================================================
# HitsNaGo Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and populate the values below with your keys:
#
# cp .env.local.example .env.local
#
# ==============================================================================
# Clerk Authentication Configuration
# Obtain your API keys from Clerk Dashboard: https://dashboard.clerk.com/
# ==============================================================================

# Clerk Publishable Key (Client-side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Clerk Secret Key (Server-side - KEEP SECRET, NEVER COMMIT)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Authentication Routing URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ==============================================================================
# Supabase Database Configuration
# Obtain your API keys from Supabase Dashboard: Project Settings > API
# ==============================================================================

# Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Server-side - KEEP SECRET, NEVER COMMIT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# Super Admin Configuration
# Specify your administrator Gmail/email here (defaults to jake.magtibay@urios.edu.ph)
# ==============================================================================
ADMIN_EMAIL=your-admin-email@gmail.com
